# Environment
ENVIRONMENT=docker

# PlayerZero Configuration
# Project ID: For frontend Web SDK (user sessions, errors, interactions)
PLAYERZERO_PROJECT_ID=your-playerzero-project-id-here

# OTLP Exporter Configuration
# Set to 'false' to disable telemetry entirely
OTEL_ENABLED=true

# Default PlayerZero OTLP endpoint (HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=https://sdk.playerzero.app/otlp

# Service name (dataset name in PlayerZero)
OTEL_SERVICE_NAME=My Dataset Name

# Note: Authorization headers are preconfigured in tracing.js and tracing.py
# Headers: Authorization=Bearer 697853e8466deb4c15041e24, X-PzProd=true
# Exporters enabled: traces, logs, metrics
