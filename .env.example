# Environment
ENVIRONMENT=docker

# PlayerZero Configuration
# Get your credentials from: https://playerzero.ai/settings
# API Key: For backend OTLP telemetry (OpenTelemetry)
# Project ID: For frontend Web SDK (user sessions, errors, interactions)
PLAYERZERO_API_KEY=your-playerzero-api-key-here
PLAYERZERO_PROJECT_ID=your-playerzero-project-id-here

# OTLP Exporter Endpoint
# Default PlayerZero OTLP endpoint (HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.playerzero.app

# Alternative: Use gRPC endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-grpc.playerzero.app
