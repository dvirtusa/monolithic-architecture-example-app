<html>
    <head>
        <script>
            window.playerZeroConfig = {
                projectId: '<%= process.env.PLAYERZERO_PROJECT_ID || "" %>',
                enabled: '<%= process.env.PLAYERZERO_PROJECT_ID ? "true" : "false" %>',
                metadata: {
                    app: 'nodejs-monolithic-app',
                    environment: '<%= process.env.OTEL_ENVIRONMENT || "development" %>'
                }
            };
        </script>
        <script src="https://cdn.playerzero.app/playerzero.js" async></script>
        <style>
            body {
                padding: 50px;
            }
        </style>
    </head>
    <body>
        <h1>Monolithic Architecture Application</h1>
        <hr>
        <div id="error-message" style="color: red; display: none; margin-bottom: 10px;"></div>
        <form action="" id="register">
            <input type="text" name="name" id="name" placeholder="enter name" required minlength="2">
            <input type="email" name="email" id="email" placeholder="enter email" required>
            <button onclick="register(event)">Register</button>
        </form>

        <div id="info">
            <p>You are registered and logged in!</p>
            <p>Name: <span id="span-name"></span></p>
            <p>Email: <span id="span-email"></span></p>
            <button onclick="logout()">Logout</button>
        </div>

        <script
        src="https://code.jquery.com/jquery-3.4.0.min.js"
        integrity="sha256-BJeo0qm959uMBGb65z40ejJYGSgR7REI4+CW1fNKwOg="
        crossorigin="anonymous"></script>

        <script>

        function logout() {
            localStorage.clear();
            location.reload();
        }
        
        function showError(message) {
            $("#error-message").text(message).show();
            setTimeout(() => $("#error-message").hide(), 5000);
        }

        function register(event) {
            event.preventDefault();
            $("#error-message").hide();
            
            const name = $("#name").val().trim();
            const email = $("#email").val().trim();

            // Client-side validation
            if (!name) {
                showError("Name is required");
                return;
            }
            
            if (!email) {
                showError("Email is required");
                return;
            }

            $.ajax({
                type: "POST",
                url: "http://localhost:8080/register",
                data: JSON.stringify({ name: name, email: email }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function(result){ 
                    localStorage.setItem("email", result.email);
                    localStorage.setItem("name", result.name);
                    if (window.PlayerZero) {
                        window.PlayerZero.identify(result.email, {
                            name: result.name,
                            email: result.email
                        });
                    }
                    location.reload();
                },
                error: function(xhr) {
                    const response = xhr.responseJSON;
                    const errorMsg = response && response.message 
                        ? response.message 
                        : "Registration failed. Please try again.";
                    showError(errorMsg);
                }
            });
        }

        $(document).ready(() => {
            if (localStorage.getItem("email")) {
                const email = localStorage.getItem("email");
                const name = localStorage.getItem("name");
                $("#span-name").text(name);
                $("#span-email").text(email);
                $("#register").toggle();
                
                if (window.PlayerZero) {
                    window.PlayerZero.identify(email, {
                        name: name,
                        email: email
                    });
                }
            } else {
                $("#info").toggle();
            }
        });
        
        </script>
    </body>
</html>